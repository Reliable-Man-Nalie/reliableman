# Copy to .env.local for local work. On Vercel, add each one under
# Project -> Settings -> Environment Variables (Production).

# ---- Required: database (Supabase) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string (Supabase -> Connect -> Session pooler URI). The build uses it
# to create the tables by itself. Nothing to paste into Supabase.
DATABASE_URL=

# ---- Required: login to /os ----
OS_ADMIN_PASSWORD=        # your dashboard password, 16+ characters
AUTH_SECRET=              # any long random string (openssl rand -hex 32)
OS_STAFF_PASSWORD=        # optional second login for an assistant

# ---- Your business (shown on invoices, proposals, emails, event pages) ----
NEXT_PUBLIC_BUSINESS_NAME=Reliable Man
NEXT_PUBLIC_DASHBOARD_LABEL=Dashboard
NEXT_PUBLIC_OWNER_NAME=Nalie
NEXT_PUBLIC_OWNER_ROLE=Coach
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_TAX_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SITE_URL=         # your domain, e.g. https://www.yourdomain.com (links in emails use it)
NEXT_PUBLIC_LOGO_URL=/logo.png
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_TIME_ZONE=Europe/Berlin
NEXT_PUBLIC_COMMUNITY_URL=   # optional WhatsApp/Telegram group link for event guests

# ---- Bank transfer details (leave empty to hide the bank block) ----
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_BIC=
NEXT_PUBLIC_BANK_NOTE=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Your Name <hello@mail.yourdomain.com>"
EMAIL_REPLY_TO=
OWNER_EMAIL=              # where new lead / signature alerts go
LEAD_NOTIFY_EMAIL=

# ---- Payments (Stripe), optional ----
STRIPE_SECRET_KEY=

# ---- PDFs of invoices and proposals (PDFShift), optional ----
PDFSHIFT_API_KEY=

# ---- Meta pixel + Conversions API, optional ----
NEXT_PUBLIC_META_PIXEL_IDS=
META_CAPI_TOKEN=

# ---- Advanced, optional ----
CRON_SECRET=
SESSION_COOKIE_DOMAIN=
NEXT_PUBLIC_PORTAL_HOSTNAME=
LEAD_ALLOWED_ORIGINS=     # your landing page domain(s), so its form can post leads here
